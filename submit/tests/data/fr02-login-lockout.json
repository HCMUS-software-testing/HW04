  {
    "id": "FR02-TC07",
    "title": "Account is locked after three consecutive wrong passwords",
    "type": "negative",
    "mode": "hybrid",
    "precondition": "Default user exists and lockout state is reset.",
    "input": {
      "email": "test@eshop.com",
      "wrongPassword": "WrongPassword!",
      "correctPassword": "Test1234!",
      "failedAttempts": 3
    },
    "expected": {
      "statusWhenLocked": 403,
      "lockDurationSeconds": 30,
      "errorContains": "Tài khoản đã bị khóa"
    },
    "hw02Reference": "TC07"
  },
  {
    "id": "FR02-TC08",
    "title": "Parallel brute-force attempts enforce lockout threshold",
    "type": "edge",
    "mode": "api",
    "precondition": "Default user exists and lockout state is reset.",
    "input": {
      "email": "test@eshop.com",
      "password": "WrongPassword!",
      "parallelRequests": 5,
      "endpoint": "/api/login"
    },
    "expected": {
      "someStatusesInclude": 403,
      "accountLockedAfterRun": true
    },
    "hw02Reference": "TC08"
  },
  {
    "id": "FR02-TC09",
