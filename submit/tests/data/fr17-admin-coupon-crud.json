  {
    "id": "FR17-TC01",
    "title": "Admin can list coupons",
    "type": "positive",
    "mode": "hybrid",
    "precondition": "Admin is logged in.",
    "input": {
      "operation": "list",
      "endpoint": "/api/coupons",
      "token": "admin"
    },
    "expected": {
      "status": 200,
      "containsCodes": ["SAVE10", "BIGBUY", "VIP100", "EXPIRED"]
    },
    "hw02Reference": "TC01"
  },
  {
